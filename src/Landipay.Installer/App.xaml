<Application x:Class="Landipay.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Mesma biblioteca de tema do cliente: um token, um significado. -->
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Componentes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
