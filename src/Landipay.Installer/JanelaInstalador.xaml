<Window x:Class="Landipay.Installer.JanelaInstalador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Landipay.Installer.Conversores"
        Title="Landipay — Instalador" Height="800" Width="1160"
        MinHeight="700" MinWidth="980"
        Icon="{DynamicResource Lp.Logo.Icone}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lp.Brush.Page}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:InteiroParaVisibilidade x:Key="PassoVisivel" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolParaVisibilidadeInversa x:Key="NaoVis" />
        <conv:TextoParaVisibilidade x:Key="TextoVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource Lp.Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Lp.Brush.Divider}" BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel>
                <!-- versão primeiro (dock right): assim o subtítulo ocupa só o espaço restante
                     e nunca escreve por cima dela -->
                <Button DockPanel.Dock="Right" Content="Tema" Style="{StaticResource Lp.Button.Ghost}"
                        Click="Tema_Click" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="v1.0" VerticalAlignment="Center"
                           Style="{StaticResource Lp.Body}" Margin="16,0,0,0"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                <Image DockPanel.Dock="Left" Source="{DynamicResource Lp.Logo.Horizontal}" Height="26"
                       VerticalAlignment="Center" />
                <TextBlock Text="Instalador · instalação por usuário, sem administrador"
                           Margin="18,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Lp.Caps}"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" />
            </DockPanel>
        </Border>

        <!-- Corpo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Trilha de passos -->
            <Border Grid.Column="0" Background="{DynamicResource Lp.Brush.Surface}"
                    BorderBrush="{DynamicResource Lp.Brush.Divider}" BorderThickness="0,0,1,0" Padding="24,24">
                <ItemsControl ItemsSource="{Binding Passos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="ativo">
                                                <Setter Property="Background" Value="{DynamicResource Lp.Brush.AccentSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Lp.Brush.AccentSoftBorder}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="ok">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Lp.Brush.BorderStrong}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="falha">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Lp.Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="18" Text="●" VerticalAlignment="Top"
                                               FontSize="11" Margin="0,3,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.BorderStrong}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="ativo">
                                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="falha">
                                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Descricao}" FontSize="12" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Conteúdo do passo -->
            <Grid Grid.Column="1" Margin="32,26,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid>

                        <!-- PASSO 1 -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=0}">
                            <TextBlock Text="Pré-requisitos" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="Nada é instalado nesta etapa: só verificamos o ambiente. Se algo estiver pendente, nada é alterado." />
                            <Border Style="{StaticResource Lp.Card}">
                                <StackPanel>
                                    <TextBlock Text="O QUE SERÁ VERIFICADO" Style="{StaticResource Lp.Caps}"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="• Runtime .NET 8 ou superior presente na máquina" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="• Permissão de escrita na pasta de dados" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap"
                                               Text="• Pelo menos 200 MB livres" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Lp.Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="PASTA DE DADOS" Style="{StaticResource Lp.Caps}"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding PastaDeDados}" FontFamily="Consolas" FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Lp.Brush.TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PASSO 2 -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=1}">
                            <TextBlock Text="Banco de dados" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="O schema é criado por migração versionada. Rodar de novo sobre uma base existente não apaga nem duplica nada." />
                            <Border Style="{StaticResource Lp.Card}">
                                <StackPanel>
                                    <TextBlock Text="IDEMPOTÊNCIA" Style="{StaticResource Lp.Caps}"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="• Sem engine de banco para instalar — o arquivo fica na pasta de dados" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="• Nenhuma conexão com servidor remoto" />
                                    <TextBlock Style="{StaticResource Lp.Body}" TextWrapping="Wrap"
                                               Text="• Reinstalar = reaproveitar os dados existentes" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PASSO 3 -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=2}">
                            <TextBlock Text="Empresa" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="Consultar o CNPJ é conveniência, não requisito: sem internet, preencha à mão e siga." />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CNPJ" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Buscar CNPJ" Style="{StaticResource Lp.Button.Secondary}"
                                        Command="{Binding BuscarCnpjCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="RAZÃO SOCIAL" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NOME FANTASIA" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding NomeFantasia, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LOGRADOURO" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Logradouro, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NÚMERO" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BAIRRO" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CIDADE" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="UF" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Uf, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="CEP" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CÓDIGO DA LOJA" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding CodigoLoja, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NOME DA LOJA" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Text="{Binding NomeLoja, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- PASSO 4 -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=3}">
                            <TextBlock Text="Ativação" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="Cole o código de licença recebido. A verificação é feita aqui, offline, com a chave pública do emissor — nada é enviado para a internet." />
                            <Border Style="{StaticResource Lp.Card}">
                                <StackPanel>
                                    <TextBlock Text="CÓDIGO DE LICENÇA" Style="{StaticResource Lp.Caps}"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,10" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Height="120"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="12"
                                             Text="{Binding TokenLicenca, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Lp.Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                               Text="Licença inválida, expirada ou de outra empresa é recusada — e a recusa aparece abaixo, sem gravar nada." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PASSO 5 -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=4}">
                            <TextBlock Text="Administrador" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="A senha é definida agora e guardada com Argon2id. Não existe senha padrão de fábrica." />
                            <Border Style="{StaticResource Lp.Card}">
                                <StackPanel>
                                    <TextBlock Text="LOGIN" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Lp.TextBox}" Margin="0,0,0,14"
                                             Text="{Binding AdminLogin, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="SENHA (MÍNIMO 10 CARACTERES)" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="SenhaBox" Style="{StaticResource Lp.PasswordBox}" Margin="0,0,0,14"
                                                 PasswordChanged="Senha_Alterada" />

                                    <TextBlock Text="CONFIRMAÇÃO" Style="{StaticResource Lp.Label}" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="ConfirmacaoBox" Style="{StaticResource Lp.PasswordBox}"
                                                 PasswordChanged="Confirmacao_Alterada" />
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <!-- PASSO 6 — escolha dos aplicativos da estação -->
                        <StackPanel Visibility="{Binding Passo, Converter={StaticResource PassoVisivel}, ConverterParameter=5}">
                            <TextBlock Text="Aplicativos" Style="{StaticResource Lp.H1}" />
                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,8,0,20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="Os dois aplicativos já estão instalados nesta máquina. Escolha quais esta estação pode abrir — o isolamento de verdade é por permissão no serviço, não por este botão." />

                            <Border Style="{StaticResource Lp.Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding InstalarAdmin}"
                                              IsEnabled="{Binding LicencaPermiteAdmin}" Margin="0,4,0,0"
                                              Foreground="{DynamicResource Lp.Brush.TextPrimary}" FontSize="14">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Landipay Admin — gestão" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                                            <TextBlock Text="Cadastros, relatórios, usuários, configurações e licença."
                                                       Style="{StaticResource Lp.Body}"
                                                       Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <Border Height="1" Background="{DynamicResource Lp.Brush.Divider}" Margin="0,14" />

                                    <CheckBox IsChecked="{Binding InstalarCaixa}"
                                              IsEnabled="{Binding LicencaPermiteCaixa}"
                                              Foreground="{DynamicResource Lp.Brush.TextPrimary}" FontSize="14">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Landipay Caixa — frente de caixa" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                                            <TextBlock Text="Venda, pagamento, sangria/suprimento e turno. Sem relatórios nem cadastros."
                                                       Style="{StaticResource Lp.Body}"
                                                       Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Lp.Brush.Inset}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                    BorderBrush="{DynamicResource Lp.Brush.Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LICENÇA PERMITE" Style="{StaticResource Lp.Caps}"
                                               Foreground="{DynamicResource Lp.Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EscopoLicenca}" Margin="12,0,0,0" FontSize="13"
                                               Foreground="{DynamicResource Lp.Brush.PrimaryOnSurface}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Lp.Body}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                       Text="Marcar os dois deixa a estação mista (ex.: máquina do gerente). Cada usuário só entra com o papel que o backend reconhecer." />
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- Mensagem + console -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Mensagem, Converter={StaticResource TextoVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Success}" />
                                <Setter Property="FontSize" Value="13" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensagemDeErro}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="{DynamicResource Lp.Brush.Inset}" CornerRadius="8"
                            BorderBrush="{DynamicResource Lp.Brush.Border}" BorderThickness="1" Padding="12,10">
                        <ListBox ItemsSource="{Binding Log}" Height="96" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource Lp.Brush.TextMuted}"
                                 FontFamily="Consolas" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="{DynamicResource Lp.Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Lp.Brush.Divider}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel>
                <Button Content="Voltar" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding VoltarCommand}" DockPanel.Dock="Left" MinWidth="110" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Avançar" Style="{StaticResource Lp.Button.Primary}" MinWidth="150"
                            Command="{Binding AvancarCommand}"
                            Visibility="{Binding Concluido, Converter={StaticResource NaoVis}}" />
                    <Button Content="Concluir e fechar" Style="{StaticResource Lp.Button.Primary}" MinWidth="170"
                            Click="Fechar_Click"
                            Visibility="{Binding Concluido, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
