<UserControl x:Class="Landipay.Ui.Views.LicencaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Lp.Card}" Width="560"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,28">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"
                        Background="{DynamicResource Lp.Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Lp.Brush.Warning}" BorderThickness="1">
                    <TextBlock Text="!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Lp.Brush.Warning}" />
                </Border>

                <TextBlock Text="{Binding Titulo}" Style="{StaticResource Lp.H1}" Margin="0,16,0,8" />
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource Lp.Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Lp.Brush.TextSecondary}" />

                <Border Background="{DynamicResource Lp.Brush.Inset}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource Lp.Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Lp.Body}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Lp.Brush.PrimaryOnSurface}" />
                        <TextBlock Text="{Binding Codigo}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Instrucao}" Style="{StaticResource Lp.Body}" TextWrapping="Wrap"
                           Margin="0,16,0,0" Foreground="{DynamicResource Lp.Brush.TextMuted}" />

                <Button Content="Verificar novamente" Style="{StaticResource Lp.Button.Secondary}" Height="42"
                        Margin="0,22,0,0" Command="{Binding VerificarCommand}" HorizontalAlignment="Left"
                        MinWidth="180" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
