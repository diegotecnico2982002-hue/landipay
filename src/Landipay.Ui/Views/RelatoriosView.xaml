<UserControl x:Class="Landipay.Ui.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Lp.Brush.Page}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho + período -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Relatórios" Style="{StaticResource Lp.H1}" />
                <TextBlock Text="{Binding ResumoTexto}" Style="{StaticResource Lp.Body}"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Hoje" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding HojeCommand}" Margin="0,0,6,0" />
                <Button Content="7 dias" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding SeteDiasCommand}" Margin="0,0,6,0" />
                <Button Content="Este mês" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding MesCommand}" Margin="0,0,14,0" />

                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="DE" Style="{StaticResource Lp.Caps}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding De}" Width="130" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="ATÉ" Style="{StaticResource Lp.Caps}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding Ate}" Width="130" />
                </StackPanel>
                <Button Content="Atualizar" Style="{StaticResource Lp.Button.Primary}"
                        Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" MinWidth="110" />
            </StackPanel>
        </DockPanel>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource Lp.Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="FATURAMENTO" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock Text="{Binding Faturamento}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lp.Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="VENDAS" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock Text="{Binding Vendas}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lp.Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TICKET MÉDIO" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock Text="{Binding TicketMedio}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lp.Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="DESCONTOS" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock Text="{Binding Descontos}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lp.Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SANGRIA / SUPRIMENTO" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{DynamicResource Lp.Brush.TextSecondary}">
                        <Run Text="{Binding Sangrias, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding Suprimentos, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Lp.Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="DIFERENÇA DE CAIXA" Style="{StaticResource Lp.Caps}"
                               Foreground="{DynamicResource Lp.Brush.TextMuted}" />
                    <TextBlock Text="{Binding DiferencaCaixa}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiferencaNegativa}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Detalhamento -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="POR FORMA DE PAGAMENTO" Style="{StaticResource Lp.Caps}"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Lp.Card}" Padding="14,6">
                    <ItemsControl ItemsSource="{Binding Formas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Forma}" FontSize="14"
                                                   Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Lp.Brush.TextMuted}">
                                            <Run Text="{Binding Lancamentos, Mode=OneWay}" />
                                            <Run Text=" lançamento(s)" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="14"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Lp.Brush.PrimaryOnSurface}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="CONFERÊNCIA DE TURNOS" Style="{StaticResource Lp.Caps}"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,18,0,8" />
                <Border Style="{StaticResource Lp.Card}" Padding="0">
                    <DataGrid Style="{StaticResource Lp.DataGrid}" ItemsSource="{Binding Turnos}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TURNO" Binding="{Binding Numero}" Width="60" />
                            <DataGridTextColumn Header="ABERTURA" Binding="{Binding Abertura}" Width="110" />
                            <DataGridTextColumn Header="DIFERENÇA" Binding="{Binding Diferenca}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiferencaNegativa}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="PRODUTOS MAIS VENDIDOS NO PERÍODO (POR VALOR)" Style="{StaticResource Lp.Caps}"
                           Foreground="{DynamicResource Lp.Brush.TextMuted}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Lp.Card}" Padding="0">
                    <DataGrid Style="{StaticResource Lp.DataGrid}" ItemsSource="{Binding Produtos}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="*" />
                            <DataGridTextColumn Header="QTD" Binding="{Binding Quantidade}" Width="100" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
