<UserControl x:Class="Landipay.Ui.Views.CaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho da operação -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding NomeLoja}" Style="{StaticResource Lp.H2}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Lp.Brush.AccentSoft}" CornerRadius="999"
                        Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTurno}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Lp.Brush.PrimaryOnSurface}" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Style="{StaticResource Lp.TextBox}" Width="90" Margin="0,0,8,0"
                         Text="{Binding ValorMovimento, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource Lp.TextBox}" Width="170" Margin="0,0,8,0"
                         Text="{Binding MotivoMovimento, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Abrir turno" Style="{StaticResource Lp.Button.Secondary}"
                        Command="{Binding AbrirTurnoCommand}" Margin="0,0,8,0" />
                <Button Content="Sangria" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding SangriaCommand}" Margin="0,0,8,0" />
                <Button Content="Suprimento" Style="{StaticResource Lp.Button.Ghost}"
                        Command="{Binding SuprimentoCommand}" Margin="0,0,12,0" />
                <TextBox Style="{StaticResource Lp.TextBox}" Width="110" Margin="0,0,8,0"
                         Text="{Binding ValorFechamento, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Valor contado na gaveta no fechamento" />
                <Button Content="Fechar turno" Style="{StaticResource Lp.Button.Secondary}"
                        Command="{Binding FecharTurnoCommand}" />
            </StackPanel>
        </Grid>

        <!-- Leitura de código -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Lp.TextBox}" Height="46"
                     FontFamily="Consolas" FontSize="15"
                     Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Bipe o código de barras ou digite o SKU e pressione Enter">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AdicionarCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Content="Adicionar" Style="{StaticResource Lp.Button.Secondary}"
                    Height="46" Margin="8,0,0,0" Command="{Binding AdicionarCommand}" />
        </Grid>

        <!-- Itens da venda -->
        <DataGrid Grid.Row="2" Style="{StaticResource Lp.DataGrid}"
                  ItemsSource="{Binding Itens}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="*" />
                <DataGridTextColumn Header="QTD" Binding="{Binding QuantidadeFormatada}" Width="80" />
                <DataGridTextColumn Header="UNITÁRIO" Binding="{Binding UnitarioFormatado}" Width="120" />
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFormatado}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totais e ações -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Mensagem}" FontSize="12" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemDeErro}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Lp.Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="SUBTOTAL" Style="{StaticResource Lp.Caps}" />
                    <TextBlock Text="{Binding Subtotal}" FontSize="14" FontFamily="Consolas"
                               Foreground="{DynamicResource Lp.Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="PAGO" Style="{StaticResource Lp.Caps}" />
                    <TextBlock Text="{Binding Pago}" FontSize="14" FontFamily="Consolas"
                               Foreground="{DynamicResource Lp.Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL" Style="{StaticResource Lp.Caps}" />
                    <TextBlock Text="{Binding Total}" FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{DynamicResource Lp.Brush.TextPrimary}" />
                </StackPanel>

                <Button Content="Dinheiro" Style="{StaticResource Lp.Button.Secondary}" Margin="0,0,8,0"
                        Command="{Binding PagarCommand}" CommandParameter="Dinheiro" />
                <Button Content="PIX" Style="{StaticResource Lp.Button.Secondary}" Margin="0,0,8,0"
                        Command="{Binding PagarCommand}" CommandParameter="Pix" />
                <Button Content="Cartão" Style="{StaticResource Lp.Button.Secondary}" Margin="0,0,8,0"
                        Command="{Binding PagarCommand}" CommandParameter="Credito" />
                <Button Content="Finalizar" Style="{StaticResource Lp.Button.Primary}" Height="46"
                        Command="{Binding FinalizarCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
