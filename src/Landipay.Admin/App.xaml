<Application x:Class="Landipay.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Landipay.Ui.ViewModels;assembly=Landipay.Ui"
             xmlns:v="clr-namespace:Landipay.Ui.Views;assembly=Landipay.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Componentes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App Admin: só telas de gestão. Caixa não existe neste executável. -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <v:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
                <v:RelatoriosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProdutosViewModel}">
                <v:ProdutosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AcessoNegadoViewModel}">
                <v:AcessoNegadoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
