<Application x:Class="Landipay.Pos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Landipay.Ui.ViewModels;assembly=Landipay.Ui"
             xmlns:v="clr-namespace:Landipay.Ui.Views;assembly=Landipay.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Landipay.Theme;component/Themes/Componentes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App Caixa: só a frente de caixa. Nenhuma tela de relatório ou cadastro é sequer
                 carregável neste executável. -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <v:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CaixaViewModel}">
                <v:CaixaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AcessoNegadoViewModel}">
                <v:AcessoNegadoView />
            </DataTemplate>

            <!-- Licença expirada/revogada: aparece no lugar do login. A venda já está barrada
                 no serviço; esta tela é a explicação. -->
            <DataTemplate DataType="{x:Type vm:LicencaViewModel}">
                <v:LicencaView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
